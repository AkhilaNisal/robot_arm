<?xml version="1.0"?>

<robot name="generic_robot_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Robot dimensions -->
    <xacro:property name="base_height" value="0.15"/>
    <xacro:property name="link1_length" value="0.30"/>
    <xacro:property name="link2_length" value="0.25"/>
    <xacro:property name="link3_length" value="0.20"/>
    <xacro:property name="link4_length" value="0.12"/>
    <xacro:property name="link5_length" value="0.10"/>

    <!-- Materials -->
    <material name="blue">
        <color rgba="0.2 0.4 0.8 1"/>
    </material>

    <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
    </material>

    <!-- Base -->
    <link name="base_link">

        <visual>
            <geometry>
                <cylinder radius="0.12" length="${base_height}"/>
            </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0"/>
            <material name="gray"/>
        </visual>

    </link>

    <!-- Link 1 -->
    <link name="link_1">

        <visual>
            <origin xyz="0 0 ${link1_length/2}"/>
            <geometry>
                <cylinder radius="0.055" length="${link1_length}"/>
            </geometry>
            <material name="blue"/>
        </visual>

    </link>

    <joint name="joint_1" type="revolute">
        <parent link="base_link"/>
        <child link="link_1"/>
        <origin xyz="0 0 ${base_height}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="100" velocity="2.0"/>
    </joint>

    <!-- Link 2 -->
    <link name="link_2">

        <visual>
            <origin xyz="0 0 ${link2_length/2}"/>
            <geometry>
                <cylinder radius="0.045" length="${link2_length}"/>
            </geometry>
            <material name="blue"/>
        </visual>

    </link>

    <joint name="joint_2" type="revolute">
        <parent link="link_1"/>
        <child link="link_2"/>
        <origin xyz="0 0 ${link1_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.0" upper="2.0" effort="100" velocity="2.0"/>
    </joint>

    <!-- Link 3 -->
    <link name="link_3">

        <visual>
            <origin xyz="0 0 ${link3_length/2}"/>
            <geometry>
                <cylinder radius="0.04" length="${link3_length}"/>
            </geometry>
            <material name="blue"/>
        </visual>

    </link>

    <joint name="joint_3" type="revolute">
        <parent link="link_2"/>
        <child link="link_3"/>
        <origin xyz="0 0 ${link2_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.5" upper="2.5" effort="80" velocity="2.0"/>
    </joint>

    <!-- Link 4 -->
    <link name="link_4">

        <visual>
            <origin xyz="0 0 ${link4_length/2}"/>
            <geometry>
                <cylinder radius="0.035" length="${link4_length}"/>
            </geometry>
            <material name="blue"/>
        </visual>

    </link>

    <joint name="joint_4" type="revolute">
        <parent link="link_3"/>
        <child link="link_4"/>
        <origin xyz="0 0 ${link3_length}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="50" velocity="3.0"/>
    </joint>

    <!-- Link 5 -->
    <link name="link_5">

        <visual>
            <origin xyz="0 0 ${link5_length/2}"/>
            <geometry>
                <cylinder radius="0.03" length="${link5_length}"/>
            </geometry>
            <material name="blue"/>
        </visual>

    </link>

    <joint name="joint_5" type="revolute">
        <parent link="link_4"/>
        <child link="link_5"/>
        <origin xyz="0 0 ${link4_length}" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <limit lower="-2.0" upper="2.0" effort="40" velocity="3.0"/>
    </joint>

    <!-- Link 6 -->
    <link name="link_6">

        <visual>
            <origin xyz="0 0 0.05"/>
            <geometry>
                <cylinder radius="0.025" length="0.10"/>
            </geometry>
            <material name="gray"/>
        </visual>

    </link>

    <joint name="joint_6" type="revolute">
        <parent link="link_5"/>
        <child link="link_6"/>
        <origin xyz="0 0 ${link5_length}" rpy="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-3.14" upper="3.14" effort="30" velocity="3.0"/>
    </joint>

    <!-- End-effector frame -->
    <link name="tool0"/>

    <joint name="tool_fixed_joint" type="fixed">
        <parent link="link_6"/>
        <child link="tool0"/>
        <origin xyz="0 0 0.10" rpy="0 0 0"/>
    </joint>

</robot>
